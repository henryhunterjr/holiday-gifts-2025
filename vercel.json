{
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/((?!robots[.]txt$|sitemap[.]xml$|catalog[.]json$|give-bread-instead-2026[.]png|og-image[.]png|favicon[.]png|api/|brand-logos/|guide-tools\\.js|guide-config\\.json|maker-catalog\\.css|makers/|maker-photos/|gifts/|_next/|assets/|product-images/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "gifts.bakinggreatbread.blog"
        }
      ],
      "destination": "https://gifts.bakinggreatbread.com/:path*",
      "statusCode": 301
    }
  ]
}
